#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    upAxis = "Y"
)

def Xform "World"
{
    def Sphere "Sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Material>
        double radius = 1
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "Ground"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-5, 0, -5), (-5, 0, 5), (5, 0, 5), (5, 0, -5)]
        uniform token subdivisionScheme = "none"
    }

    def Material "Material"
    {
        token outputs:surface.connect = </World/Material/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.15, 0.55, 0.2)
            float inputs:roughness = 0.4
            token outputs:surface
        }
    }

    def DomeLight "Light"
    {
        float inputs:intensity = 0.7
    }

    def Camera "Camera"
    {
        float2 clippingRange = (0.1, 100)
        float focalLength = 45
        matrix4d xformOp:transform = ( (0.8320502943378436, 1.387778780781445e-17, -0.5547001962252291, 0), (-0.1482498633322202, 0.9636241116594313, -0.22237479499833027, 0), (0.5345224838248487, 0.26726124191242434, 0.8017837257372731, -0), (3.999999999999999, 2.9999999999999996, 5.999999999999999, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }
}

def "Render"
{
    def RenderSettings "Settings"
    {
        rel camera = </World/Camera>
        custom string cycles:device = "METAL"
        custom int cycles:samples = 8
        custom int karma:global:pixel_samples = 8
        rel products = </Render/Product>
        uniform int2 resolution = (128, 128)
    }

    def RenderProduct "Product"
    {
        rel camera = </World/Camera>
        rel orderedVars = </Render/Beauty>
        token productName = "/Users/zenray/.claude/tmp/tmp-vegetation-assets-collection-01/renderers/tests/Smoke.exr"
        uniform token productType = "raster"
        uniform int2 resolution = (128, 128)
    }

    def RenderVar "Beauty"
    {
        uniform token dataType = "color4f"
        custom string driver:parameters:aov:husk:name = "color"
        uniform string sourceName = "color"
        uniform token sourceType = "raw"
    }
}

