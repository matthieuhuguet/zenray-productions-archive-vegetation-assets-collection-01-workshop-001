def node(parent,kind,name,inputs=(),**parms):
 n=parent.createNode(kind,name,exact_type_name=kind=='curve')
 for i,x in enumerate(inputs):n.setInput(i,x[0] if isinstance(x,tuple) else x,x[1] if isinstance(x,tuple) else 0)
 for k,v in parms.items():n.parm(k).set(v)
 return n
def controls(n,params):
 g=n.parmTemplateGroup();f=hou.FolderParmTemplate('controls','Controls')
 for p in params:f.addParmTemplate(p)
 g.append(f);n.setParmTemplateGroup(g)
def fp(k,label,value,lo=0,hi=1):return hou.FloatParmTemplate(k,label,1,default_value=(value,),min=lo,max=hi)
def ip(k,label,value,lo=1,hi=128):return hou.IntParmTemplate(k,label,1,default_value=(value,),min=lo,max=hi)
def sp(k,label,value):return hou.StringParmTemplate(k,label,1,default_value=(value,))
def coords(points):return ' '.join(','.join(f'{x:.7f}' for x in p) for p in points)
def asset(n,name,path,label,inputs=0):
 g=n.parmTemplateGroup();values={p.name():p.eval() for p in n.parms() if p.name() in ['guide','radius','resolution','sides','attach_u','tip_ratio','length','width_ratio','cross_angle','taper']};a=n.createDigitalAsset(name=name,hda_file_name=path,description=label,min_num_inputs=inputs,max_num_inputs=inputs);d=a.type().definition();d.setParmTemplateGroup(g);a.setParmTemplateGroup(g)
 for k,v in values.items():a.parm(k).set(v)
 d.updateFromNode(a);return a

def output(parent,name,src,index=0):return node(parent,'output',name,[src],outputidx=index)
def group(parent,name,src):return node(parent,'groupcreate','Group_'+name,[src],groupname=name,grouptype=0,basegroup='*')
def color(parent,name,src,rgb):return node(parent,'color',name,[src],colorr=rgb[0],colorg=rgb[1],colorb=rgb[2])
